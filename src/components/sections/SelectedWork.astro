---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { projects } from "../../data/projects";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const langProjects = projects[lang] ?? projects["es"];
---

<section class="bg-background-card border-y border-white/10" id="work">
    <div
        class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-8"
    >
        <h2
            class="flex items-center gap-4 text-xs font-black tracking-[0.4em] text-white/50 uppercase"
        >
            <span class="block h-2 w-2 bg-white/50"></span>
            {t("section.work.num")} / {t("section.work.title")}
        </h2>
        <span class="font-mono text-[10px] text-white/30"
            >{t("section.work.date")}</span
        >
    </div>
</section>

<section class="mx-auto max-w-[1440px] border-x border-white/5">
    <div class="grid grid-cols-1">
        {
            langProjects.map((project) => (
                <div class="group flex flex-col items-stretch border-b border-white/10 transition-colors duration-300 hover:bg-white/5 md:flex-row">
                    <div class="flex w-full items-start justify-center border-r border-white/10 p-8 text-5xl font-black text-white/20 transition-colors group-hover:text-white md:w-40">
                        {project.index}
                    </div>
                    <div class="flex-1 p-8 md:p-12">
                        <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-start">
                            <div>
                                <h3 class="text-4xl font-black tracking-tighter text-white uppercase">
                                    {project.title}
                                </h3>
                                {project.badge && (
                                    <span class="mt-2 inline-block border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[9px] font-bold tracking-widest text-emerald-400 uppercase">
                                        {project.badge}
                                    </span>
                                )}
                            </div>
                            <div class="flex flex-wrap gap-2">
                                {project.tags.map((tag) => (
                                    <span class="border border-white/10 bg-white/5 px-3 py-1 text-[10px] font-bold tracking-wider text-white/80 uppercase">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                        <div class="mb-8 grid grid-cols-2 gap-6 border-y border-white/5 py-6 md:grid-cols-3">
                            {project.stats.map((stat) => (
                                <div
                                    class={stat.progress !== undefined ? "hidden md:block" : ""}
                                >
                                    <span class="mb-2 block text-[10px] tracking-widest text-white/40 uppercase">
                                        {stat.label}
                                    </span>
                                    {stat.value && stat.progress === undefined && (
                                        <span class="font-mono text-xl text-emerald-400">
                                            {stat.value}
                                        </span>
                                    )}
                                    {stat.progress !== undefined && (
                                        <div class="mt-3 h-1 w-full overflow-hidden bg-white/10">
                                            <div
                                                class="h-full bg-emerald-500"
                                                style={`width: ${stat.progress}%`}
                                            />
                                        </div>
                                    )}
                                    {stat.dots !== undefined && (
                                        <div class="mt-3 flex gap-1">
                                            {Array.from({ length: stat.dots }).map(() => (
                                                <div class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                                            ))}
                                        </div>
                                    )}
                                </div>
                            ))}
                        </div>
                        <p class="mb-8 max-w-3xl text-lg leading-relaxed font-light text-white/60">
                            {project.description}
                        </p>
                        {project.linkUrl && project.linkUrl !== "#" ? (
                            <a
                                class="inline-flex items-center gap-2 border-b border-white/20 pb-1 text-xs font-black tracking-widest text-white uppercase transition-colors hover:border-emerald-400 hover:text-emerald-400"
                                href={project.linkUrl}
                                target={project.linkUrl.startsWith("http") ? "_blank" : undefined}
                                rel={project.linkUrl.startsWith("http") ? "noopener noreferrer" : undefined}
                            >
                                {project.linkText ?? t("project.caseStudy")}
                                <span class="material-symbols-outlined text-sm">
                                    open_in_new
                                </span>
                            </a>
                        ) : (
                            <span class="inline-flex items-center gap-2 border-b border-white/10 pb-1 text-xs font-black tracking-widest text-white/30 uppercase">
                                {project.linkText ?? t("project.private")}
                                <span class="material-symbols-outlined text-sm">lock</span>
                            </span>
                        )}
                    </div>
                    <div class="hidden w-80 flex-col justify-between border-l border-white/10 bg-white/[0.02] p-8 lg:flex">
                        <div>
                            <div class="mb-4 text-[10px] font-black text-emerald-500 uppercase">
                                {project.challengeLabel ?? t("project.challenge")}
                            </div>
                            <div class="text-sm leading-relaxed text-white/80">
                                {project.challenge}
                            </div>
                        </div>
                        <div class="mt-8 border-t border-white/10 pt-8">
                            {project.loadGraph && (
                                <>
                                    <div class="mb-2 text-[10px] text-white/30 uppercase">
                                        System Load
                                    </div>
                                    <div class="flex h-8 items-end gap-1">
                                        <div class="h-[40%] w-2 bg-white/20" />
                                        <div class="h-[60%] w-2 bg-white/20" />
                                        <div class="h-[90%] w-2 animate-pulse bg-emerald-500" />
                                        <div class="h-[50%] w-2 bg-white/20" />
                                        <div class="h-[70%] w-2 bg-white/20" />
                                        <div class="h-[45%] w-2 bg-white/20" />
                                    </div>
                                </>
                            )}
                            {project.streamGraph && (
                                <>
                                    <div class="mb-2 text-[10px] text-white/30 uppercase">
                                        Package Activity
                                    </div>
                                    <div class="flex items-center gap-[2px] opacity-70">
                                        <div class="h-6 w-1 bg-emerald-500" />
                                        <div class="h-4 w-1 bg-emerald-500/80" />
                                        <div class="h-7 w-1 bg-emerald-500" />
                                        <div class="h-3 w-1 bg-emerald-500/60" />
                                        <div class="h-5 w-1 bg-emerald-500/90" />
                                        <div class="h-2 w-1 bg-emerald-500/50" />
                                        <div class="h-6 w-1 bg-emerald-500" />
                                        <div class="h-8 w-1 bg-white" />
                                        <div class="h-5 w-1 bg-emerald-500" />
                                    </div>
                                </>
                            )}
                            {project.topology && (
                                <>
                                    <div class="mb-2 text-[10px] text-white/30 uppercase">
                                        In Progress
                                    </div>
                                    <div class="relative h-8 w-full overflow-hidden border border-white/10 bg-black/50">
                                        <div class="absolute inset-0 flex items-center justify-around opacity-30">
                                            <div class="h-1 w-full bg-emerald-500/50" />
                                        </div>
                                        <div class="absolute top-1/2 left-1/4 h-2 w-2 -translate-y-1/2 rounded-full bg-emerald-500" />
                                        <div class="absolute top-1/2 left-1/2 h-2 w-2 -translate-y-1/2 rounded-full bg-emerald-500/50 animate-pulse" />
                                        <div class="absolute top-1/2 right-1/4 h-2 w-2 -translate-y-1/2 rounded-full bg-emerald-500" />
                                    </div>
                                </>
                            )}
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</section>
