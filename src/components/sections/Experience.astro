---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { experience } from "../../data/experience";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const langExperience = experience[lang] ?? experience["es"];
---

<section class="bg-background-card border-y border-white/10" id="experience">
    <div
        class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-8"
    >
        <h2
            class="flex items-center gap-4 text-xs font-black tracking-[0.4em] text-white/50 uppercase"
        >
            <span class="block h-2 w-2 bg-white/50"></span>
            {t("section.experience.num")} / {t("section.experience.title")}
        </h2>
        <span class="font-mono text-[10px] text-white/30"
            >{t("section.experience.subtitle")}</span
        >
    </div>
</section>

<section class="mx-auto max-w-[1440px] border-x border-white/5">
    {
        langExperience.map((entry, entryIndex) => (
            <div class="border-b border-white/10 p-8 md:p-12">
                <!-- Company Header -->
                <div class="mb-10 flex flex-col gap-2 border-b border-white/5 pb-8 md:flex-row md:items-end md:justify-between">
                    <div>
                        <h3 class="text-2xl font-black tracking-tighter text-white uppercase md:text-3xl">
                            {entry.company}
                        </h3>
                        <p class="mt-1 font-mono text-sm text-white/40">
                            {entry.totalDuration}
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {entry.tags.map((tag) => (
                            <span class="border border-white/10 bg-white/5 px-2 py-0.5 text-[9px] font-bold tracking-wider text-white/60 uppercase">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>

                <!-- Roles Timeline -->
                <div class="relative space-y-10 pl-6 md:pl-10">
                    <!-- Vertical line -->
                    <div class="absolute top-2 bottom-2 left-0 w-[1px] bg-white/10" />

                    {entry.roles.map((role, i) => (
                        <div class="relative">
                            <!-- Timeline dot -->
                            <div
                                class={`absolute -left-[29px] top-1.5 h-3 w-3 border-2 md:-left-[37px] ${entryIndex === 0 && i === 0 ? "border-emerald-500 bg-emerald-500/20" : "border-white/30 bg-background"}`}
                            />

                            <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:gap-6">
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-3">
                                        <h4 class="text-lg font-black tracking-tight text-white">
                                            {role.title}
                                        </h4>
                                        {entryIndex === 0 && i === 0 && (
                                            <span class="inline-flex items-center gap-1.5 border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[9px] font-bold tracking-widest text-emerald-400 uppercase">
                                                <span class="relative flex h-1.5 w-1.5">
                                                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
                                                    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500" />
                                                </span>
                                                {t("experience.present")}
                                            </span>
                                        )}
                                    </div>
                                    <p class="mt-1 font-mono text-[11px] text-white/40">
                                        {role.period} · {role.duration}
                                    </p>
                                </div>
                            </div>

                            <ul class="mt-4 space-y-2">
                                {role.bullets.map((bullet) => (
                                    <li class="flex gap-3 text-sm leading-relaxed text-white/60">
                                        <span class="mt-[7px] h-1 w-1 flex-shrink-0 bg-emerald-500/60" />
                                        {bullet}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        ))
    }
</section>
