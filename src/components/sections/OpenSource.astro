---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const packages = [
    {
        name: "@chetodb/business-central",
        install: "pnpm add @chetodb/business-central",
        version: "0.1.2",
        status: "active" as const,
        npmUrl: "https://www.npmjs.com/package/@chetodb/business-central",
        descEs:
            "SDK type-safe para integrar Microsoft Dynamics 365 Business Central en proyectos TypeScript. Abstracción resiliente sobre la API OData de Business Central.",
        descEn:
            "Type-safe SDK to integrate Microsoft Dynamics 365 Business Central into TypeScript projects. Resilient abstraction over the Business Central OData API.",
    },
    {
        name: "@chetodb/nestjs-business-central",
        install: "pnpm add @chetodb/nestjs-business-central",
        version: "0.1.2",
        status: "active" as const,
        npmUrl: "https://www.npmjs.com/package/@chetodb/nestjs-business-central",
        descEs:
            "Módulo NestJS plug-and-play para Business Central. Integra el SDK en el ecosistema de inyección de dependencias de NestJS con configuración mínima.",
        descEn:
            "Plug-and-play NestJS module for Business Central. Integrates the SDK into NestJS dependency injection ecosystem with minimal configuration.",
    },
    {
        name: "address-kit",
        install: "pnpm add address-kit",
        version: "0.2.3",
        status: "active" as const,
        npmUrl: "https://www.npmjs.com/package/address-kit",
        descEs:
            "Librería TypeScript para resolución, normalización y enriquecimiento de direcciones postales usando Nominatim (OpenStreetMap). Caché LRU configurable y soporte para proveedores personalizados.",
        descEn:
            "TypeScript library for address resolution, normalization and enrichment using Nominatim (OpenStreetMap). Configurable LRU cache and custom provider support.",
    },
];
---

<section class="bg-background-card border-y border-white/10" id="oss">
    <div
        class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-8"
    >
        <h2
            class="flex items-center gap-4 text-xs font-black tracking-[0.4em] text-white/50 uppercase"
        >
            <span class="block h-2 w-2 bg-white/50"></span>
            {t("section.oss.num")} / {t("section.oss.title")}
        </h2>
        <span class="font-mono text-[10px] text-white/30"
            >{t("section.oss.subtitle")}</span
        >
    </div>
</section>

<section class="mx-auto max-w-[1440px] border-x border-white/5">
    <div class="grid grid-cols-1 md:grid-cols-3 divide-y divide-white/10 md:divide-y-0 md:divide-x md:divide-white/10">
        {
            packages.map((pkg) => (
                <div class="flex flex-col p-8 md:p-10">
                    <!-- Package name + badge -->
                    <div class="mb-6">
                        <a
                            href={pkg.npmUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group inline-flex items-start gap-2 hover:text-emerald-400 transition-colors"
                        >
                            <span class="font-mono text-sm font-bold text-white/90 group-hover:text-emerald-400 break-all">
                                {pkg.name}
                            </span>
                            <span class="material-symbols-outlined mt-0.5 flex-shrink-0 text-[14px] text-white/30 group-hover:text-emerald-400">
                                open_in_new
                            </span>
                        </a>
                        <div class="mt-2 flex items-center gap-2">
                            <span class="border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 font-mono text-[9px] font-bold tracking-widest text-emerald-400 uppercase">
                                v{pkg.version}
                            </span>
                            <span class="border border-white/10 bg-white/5 px-2 py-0.5 font-mono text-[9px] font-bold tracking-widest text-white/50 uppercase">
                                {pkg.status === "active"
                                    ? t("oss.status.active")
                                    : t("oss.status.wip")}
                            </span>
                        </div>
                    </div>

                    <!-- Description -->
                    <p class="mb-8 flex-1 text-sm leading-relaxed text-white/50">
                        {lang === "en" ? pkg.descEn : pkg.descEs}
                    </p>

                    <!-- Install command -->
                    <div class="border border-white/10 bg-black/30 px-4 py-3">
                        <span class="mb-1 block text-[9px] font-bold tracking-widest text-white/30 uppercase">
                            {t("oss.install")}
                        </span>
                        <code class="font-mono text-xs text-emerald-400 break-all">
                            {pkg.install}
                        </code>
                    </div>
                </div>
            ))
        }
    </div>
</section>
