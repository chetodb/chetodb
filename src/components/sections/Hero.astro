---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
    class="relative mx-auto flex min-h-[92vh] max-w-[1440px] flex-col justify-end overflow-hidden border-x border-white/5 px-6 py-20"
>
    <!-- Background Grid -->
    <div
        class="bg-grid-pattern pointer-events-none absolute inset-0 z-0 opacity-[0.03]"
    >
    </div>

    <div class="relative z-10 mb-12 md:mb-16">
        <!-- Badge -->
        <div
            class="mb-6 inline-flex items-center gap-2 border border-white/10 bg-white/5 px-3 py-1 backdrop-blur-sm md:mb-8"
        >
            <span class="relative flex h-2 w-2">
                <span
                    class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
                ></span>
                <span
                    class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
                ></span>
            </span>
            <span
                class="text-[10px] font-bold tracking-widest whitespace-nowrap text-emerald-400 uppercase"
            >
                {t("hero.badge")}
            </span>
        </div>

        <!-- Main Title -->
        <h1
            class="text-huge flex w-full flex-col leading-[0.85] font-black tracking-tighter text-white uppercase"
        >
            <span class="block">{t("hero.title1")}</span>
            <span class="block">{t("hero.title2")}</span>
            <span class="block text-white/30">{t("hero.title3")}</span>
        </h1>
    </div>

    <!-- Info & CTA -->
    <div
        class="relative z-10 flex flex-col items-start justify-between gap-8 border-t border-white/10 pt-8 md:flex-row md:items-end md:gap-12 md:pt-12"
    >
        <p
            class="max-w-2xl text-lg leading-relaxed font-light text-white/70 md:text-xl lg:text-2xl"
        >
            {t("hero.subtitle")}
        </p>
        <div class="flex w-full md:w-auto">
            <a
                class="group flex w-full items-center justify-center gap-4 bg-white px-8 py-6 text-sm font-bold tracking-widest text-black uppercase transition-all duration-300 hover:bg-white/90 md:w-auto"
                href="#work"
            >
                {t("hero.cta")}
                <span
                    class="material-symbols-outlined transition-transform group-hover:translate-x-1"
                    >arrow_forward</span
                >
            </a>
        </div>
    </div>
</section>

<style>
    /* Responsive font-size adjustments if needed beyond clamp */
    @media (max-width: 640px) {
        .text-huge {
            font-size: clamp(2.5rem, 12vw, 4rem);
        }
    }
</style>
