---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
    class="relative mx-auto flex min-h-[92vh] max-w-[1440px] flex-col justify-center overflow-hidden border-x border-white/5 px-6 py-20 md:justify-end"
>
    <!-- Background Grid -->
    <div
        class="bg-grid-pattern pointer-events-none absolute inset-0 z-0 opacity-[0.03]"
    >
    </div>

    <div class="relative z-10 mb-8 md:mb-16">
        <!-- Badge -->
        <div
            class="mb-8 inline-flex items-center gap-2 border border-white/10 bg-white/5 px-3 py-1 backdrop-blur-sm"
        >
            <span class="relative flex h-2 w-2">
                <span
                    class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
                ></span>
                <span
                    class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
                ></span>
            </span>
            <span
                class="text-[10px] font-bold tracking-widest whitespace-nowrap text-emerald-400 uppercase"
            >
                {t("hero.badge")}
            </span>
        </div>

        <!-- Name -->
        <h1 class="text-huge font-black tracking-tighter text-white uppercase leading-[0.85]">
            {t("hero.name")}<span class="text-white/30"> Blasco</span>
        </h1>

        <!-- Role -->
        <div class="mt-4 font-mono text-[13px] font-bold tracking-[0.25em] text-white/60 uppercase">
            {t("hero.role")}
        </div>
    </div>

    <!-- Info & CTA -->
    <div class="relative z-10 border-t border-white/10 pt-8 md:pt-12">
        <!-- Tagline -->
        <p class="mb-6 border-l-2 border-emerald-500 pl-4 text-sm font-medium tracking-wide text-white/80 md:text-base lg:text-lg">
            {t("hero.tagline")}
        </p>
        <p class="max-w-2xl text-base leading-relaxed font-light text-white/70 md:text-lg lg:text-xl">
            {t("hero.subtitle")}
        </p>
    </div>
</section>

<style>
    /* Responsive font-size adjustments if needed beyond clamp */
    @media (max-width: 640px) {
        .text-huge {
            font-size: clamp(2.5rem, 12vw, 4rem);
        }
    }
</style>
