---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { stack as stackData } from "../../data/stack";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentStack = stackData[lang] ?? stackData["es"];
---

<section class="bg-background-card border-y border-white/10" id="philosophy">
    <div
        class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-8"
    >
        <h2
            class="flex items-center gap-4 text-xs font-black tracking-[0.4em] text-white/50 uppercase"
        >
            <span class="block h-2 w-2 bg-white/50"></span>
            {t("section.philosophy.num")} / {t("section.philosophy.title")}
        </h2>
        <span class="font-mono text-[10px] text-white/30"
            >{t("section.philosophy.subtitle")}</span
        >
    </div>
</section>

<section
    class="relative mx-auto grid max-w-[1440px] grid-cols-1 overflow-hidden border-x border-white/5 md:grid-cols-2"
>
    <div
        class="watermark-d font-display translate-x-1/4 translate-y-1/4 font-black text-white/5 select-none"
    >
        D
    </div>

    <div
        class="relative z-10 border-b border-white/10 p-12 md:border-r md:border-b-0 md:p-20"
    >
        <h4
            class="mb-12 text-4xl leading-tight font-black text-white uppercase lg:text-5xl"
        >
            {
                (() => {
                    const quote = t("philosophy.quote");
                    const strike = t("philosophy.strike");
                    const idx = quote.toLowerCase().indexOf(strike.toLowerCase());
                    if (idx === -1) return quote;
                    const before = quote.slice(0, idx);
                    const matched = quote.slice(idx, idx + strike.length);
                    const after = quote.slice(idx + strike.length);
                    return (
                        <>
                            {before}
                            <span class="mt-2 block text-white/30 line-through decoration-emerald-500 decoration-4">
                                {matched}{after}
                            </span>
                        </>
                    );
                })()
            }
        </h4>
        <div class="space-y-8">
            <p class="text-xl leading-relaxed font-light text-white/70">
                {t("philosophy.p1")}
            </p>
            <p class="text-xl leading-relaxed font-light text-white/70">
                {t("philosophy.p2")}
            </p>
        </div>
    </div>

    <div class="relative z-10 bg-white/[0.01] p-12 md:p-20" id="stack">
        <div>
            <h5
                class="mb-12 flex items-center gap-3 text-[10px] font-black tracking-[0.3em] text-emerald-400 uppercase"
            >
                <span class="h-[1px] w-6 bg-emerald-400"></span>
                {t("stack.title")}
            </h5>
            <div class="grid grid-cols-2 gap-16">
                <div>
                    <span
                        class="mb-6 block border-b border-white/20 pb-4 text-xs font-black tracking-widest text-white uppercase"
                        >{t("stack.core")}</span
                    >
                    <ul class="space-y-4 font-mono text-sm text-white/60">
                        {
                            currentStack.languages.map((item) => (
                                <li class="flex items-center gap-3">
                                    <span
                                        class={`h-1.5 w-1.5 ${item.status === "focus" ? "bg-emerald-500/50" : "bg-emerald-500"}`}
                                    />
                                    {item.name}
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div>
                    <span
                        class="mb-6 block border-b border-white/20 pb-4 text-xs font-black tracking-widest text-white uppercase"
                        >{t("stack.infra")}</span
                    >
                    <ul class="space-y-4 font-mono text-sm text-white/60">
                        {
                            currentStack.infrastructure.map((item) => (
                                <li class="flex items-center gap-3">
                                    <span class="material-symbols-outlined text-[14px]">
                                        {item.icon}
                                    </span>
                                    {item.name}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="mt-16 border-t border-white/5 pt-12">
            <div
                class="mb-4 text-[10px] font-bold tracking-widest text-white/30 uppercase"
            >
                {t("stack.focus")}
            </div>
            <p class="font-mono text-sm leading-relaxed text-white/50">
                {currentStack.currentFocus}
            </p>
        </div>
    </div>
</section>
